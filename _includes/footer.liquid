{% capture footer_icons %}
  <div class="text-center mt-3">
    <a href="mailto:{{ site.email }}" title="Email"><i class="fas fa-envelope fa-4x mx-3"></i></a>
    <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar" target="_blank"><i class="ai ai-google-scholar ai-4x mx-3"></i></a>
    <a href="https://orcid.org/{{ site.orcid_id }}" title="ORCID" target="_blank"><i class="ai ai-orcid ai-4x mx-3"></i></a>
    <a href="https://github.com/{{ site.github_username }}" title="GitHub" target="_blank"><i class="fab fa-github fa-4x mx-3"></i></a>
    <p class="mt-3 mb-4" style="font-size: 1rem;">If you want to reach me, send me an email!</p>
  </div>
{% endcapture %}

{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}.
  {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<footer class="mt-5" role="contentinfo">
  {% if site.newsletter.enabled %}
    {% include newsletter.liquid %}
  {% endif %}

  <div class="container text-center">
    {{ footer_icons }}
    <div class="text-muted small mt-4">
      {{ footer_contents }}
    </div>
  </div>
</footer>
